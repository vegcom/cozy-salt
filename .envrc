#!/bin/sh
# Switch conda env

# shellcheck disable=SC1091
# shellcheck source=.env

[ -f .env ] && source_env .env

find ./env -type f -name '*.conf' 2>/dev/null | sort | while read -r _include; do
	[ -s "${_include}" ] && source_env "${_include}"
done

__CONDA_UPDATE=${__CONDA_UPDATE:-0}

env_name=$(grep '^name:' environment.yml | awk '{print $2}')
shell_name=$(basename "${SHELL}")

if [ -f environment.yml ]; then
	eval "$(conda shell."${shell_name}" hook)" >/dev/null
	eval "$(mamba shell hook --shell "${shell_name}")" >/dev/null
	if ! mamba env list | grep -q "$env_name\s"; then
		echo "Creating conda environment: $env_name"
		mamba env create -f environment.yml --yes
	fi
	if [ 1 -eq "${__CONDA_UPDATE}" ]; then
		mamba env update -f environment.yml --yes --verbose
	fi
	mamba activate "$env_name"
fi

exit_hook() {
	if [ -f environment.yml ]; then
		eval "$(conda shell."${shell_name}" hook)" >/dev/null
		conda deactivate
	fi
}
