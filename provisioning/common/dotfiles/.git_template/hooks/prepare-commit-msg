#!/opt/miniforge3/python
# prepare-commit-msg: prepend branch name hint to commit message
# skips merge commits, amends, and squash/fixup

# Managed by Salt - DO NOT EDIT MANUALLY

import subprocess
import sys

commit_msg_file = sys.argv[1]
commit_source = sys.argv[2] if len(sys.argv) > 2 else ""

# don't touch merges, squash, fixup, or existing messages
if commit_source in ("merge", "squash", "commit"):
    sys.exit(0)

try:
    branch = (
        subprocess.check_output(
            ["git", "symbolic-ref", "--short", "HEAD"], stderr=subprocess.DEVNULL
        )
        .decode()
        .strip()
    )
except subprocess.CalledProcessError:
    sys.exit(0)

# skip generic branches
if branch in ("main", "master", "develop", "HEAD"):
    sys.exit(0)

with open(commit_msg_file, encoding="utf-8") as f:
    content = f.read()

# already has a hint line, don't double-add
if content.startswith(f"# branch: {branch}"):
    sys.exit(0)

hint = f"# branch: {branch}\n"
with open(commit_msg_file, "w", encoding="utf-8") as f:
    f.write(hint + content)
