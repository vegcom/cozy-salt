# Managed by Salt - DO NOT EDIT MANUALLY

# ────────────────────────────────────────────────────────────────
# /etc/systemd/system/root-scratch.mount
# ────────────────────────────────────────────────────────────────
# Cozy‑Ops Mount Unit Template: scratch@.mount
# Creates an ephemeral tmpfs scratchpad at /home/root/scratch
# Zero disk writes. Predictable.
# https://www.freedesktop.org/software/systemd/man/latest/systemd-mount.html
# ────────────────────────────────────────────────────────────────

[Unit]
Description=Ephemeral scratchpad for root (tmpfs, cozy-ops style)
Documentation=man:systemd.mount(5)

[Mount]
What=tmpfs
Where=/root/scratch
Type=tmpfs

# Options tuned for comfort and safety:
#   size=4G       → bounded RAM usage
#   mode=700      → private workspace
#   noatime       → no metadata churn
#   nodev,nosuid  → keep it simple and safe
Options=size=16G,mode=700,noatime,nodev,nosuid,uid=root,gid=root

[Install]
WantedBy=multi-user.target
