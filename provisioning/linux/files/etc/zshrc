#!/bin/zsh
# Managed by Salt - DO NOT EDIT MANUALLY

if [ ! -n "$ZSH_VERSION" ]; then
  return 2>/dev/null
fi

case $- in
    *i*) ;;
    *) return 2>/dev/null ;;
esac

autoload -Uz compinit
compinit -u

if [ "$STARSHIP_DISABLE" != "true" ]; then command -v starship >/dev/null && eval "$(starship init zsh)" ; fi
if [ "$CARAPACE_DISABLE" != "true" ]; then command -v carapace >/dev/null && eval "$(carapace _carapace zsh)" ; fi
if [ "$ZOXIDE_DISABLE" != "true" ]; then command -v zoxide >/dev/null && eval "$(zoxide init zsh)" ; fi
if [ "$ATUIN_DISABLE" != "true" ]; then command -v atuin >/dev/null && eval "$(atuin init zsh)" ; fi
if [ "$FZF_DISABLE" != "true" ]; then command -v fzf >/dev/null && eval "$(fzf --zsh)" ; fi

command -v tailscale >/dev/null && eval  "$(tailscale completion zsh)"
command -v kubectl >/dev/null && eval  "$(kubectl completion zsh)"
command -v kubecolor >/dev/null && eval  "$(kubecolor completion zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
