# systemd id: b887377e9cc5490f86d7d9eb5338afda
# systemd-id128 new


# Skip processing completely for TPM device events to prevent system log noise
KERNEL=="tpmrm[0-9]*", GOTO="enum_end"

ACTION=="add", SUBSYSTEMS=="usb", RUN+="/usr/bin/sh -c '/usr/bin/logger --size=409600 -p debug -t udev $$(cyme --json --vidpid=$$VENDOR_ID:$$MODEL_ID | jq -ec)'"

LABEL="enum_end"
