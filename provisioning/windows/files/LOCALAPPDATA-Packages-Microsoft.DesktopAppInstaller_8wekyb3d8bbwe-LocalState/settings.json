{
  "$managed": "Managed by Salt - DO NOT EDIT MANUALLY",
  "$schema": "https://aka.ms/winget-settings.schema.json",
  "$path": "$env:LOCALAPPDATA/Packages/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe/LocalState/settings.json",
  "$docs": [
    "https://aka.ms/winget-settings",
    "https://learn.microsoft.com/en-us/windows/package-manager/winget/troubleshooting",
    "https://github.com/microsoft/winget-cli/blob/master/doc/Settings.md"
  ],
  "source": {"autoUpdateIntervalInMinutes": 90},
  "visual": {
    "progressBar": "sixel",
    "enableSixels": true,
    "anonymizeDisplayedPaths": true,
  },
  "logging": {
    "fileNameStrategy": "timestamp",
    "level": "verbose",
    "channels": [
      "fail",
      "cli",
      "sql",
      "repo",
      "yaml",
      "core",
      "test",
      "config",
      "default",
      "all",
    ],
    "file": {"totalSizeLimitInMB": 2048, "fileCountLimit": 128},
    "telemetry": {"level": "basic"}
  },
  "experimentalFeatures": {
    "experimentalCmd": false,
    "directMSI": true,
    "fonts": true,
    "resume": false,
    "dependencies": true,
    "sourcePriority": true
  },
  "Output": {
    "sortOrder": ["relevance", "available", "id", "name", "version"],
    "sortDirection": "descending"
  },
  "installBehavior": {
    "disableInstallNotes": true,
    "allowHashMismatch": false,
    "archiveExtractionMethod": "shellApi",
    "skipDependencies": false,
    "purgePortablePackage": true,
    "maxResumes": 5,
    "preferences": {
      "scope": "machine",
      "installerTypes": ["msi", "inno", "portable", "exe", "zip", "nullsoft", "msix", "burn", "wix", "msstore"],
      "locale": ["en-US", "fr-FR", "ja-JP", "ko-KR", "ru-RU", "zh-CN", "zh-TW"]
    },
    "requirements": {
      "installerTypes": ["msi", "inno", "portable", "exe", "zip", "nullsoft", "msix", "burn", "wix", "msstore"]
    }
  },
  "configureBehavior": {"defaultModuleRoot": "C:/Program Files/PowerShell/7/Modules"},
  "downloadBehavior": {"cacheRoot": "C:/opt/WinGet/Cache/", "useSharedCache": true},
  "installPrefReq": {"scope": "machine"}
}
