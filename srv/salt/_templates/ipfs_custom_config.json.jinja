    "Gateway": "/ip4/127.0.0.1/tcp/{{ gateway_port }}"
  },
  "Routing": {
    "Type": "dhtclient",
    "DelegatedRouters": []
  },
  "Reprovider": null,
  "Swarm": {
    "AddrFilters": [],
