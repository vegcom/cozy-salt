[global]
timeout = 60

# Tier 1 — Fastest mirror
index-url = https://pypi.org/simple

# Tier 2 — Fresh fallback mirrors
extra-index-url =
{%- if local_mirror %}
  {{ local_mirror }}
{%- endif %}
  https://pypi.mirrors.ustc.edu.cn/simple/
  https://pypi.tuna.tsinghua.edu.cn/simple

{%- if cache_path %}
# Tier 3 — Offline fallback
find-links =
  {{ cache_path }}
{%- endif %}
