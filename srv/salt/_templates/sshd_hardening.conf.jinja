
# Authentication
PermitRootLogin prohibit-password
PermitEmptyPasswords no

# Security
{% if grains['os_family'] == 'Windows' %}
KbdInteractiveAuthentication no
{% else %}
ChallengeResponseAuthentication no
UsePAM yes
{% endif %}

# Session limits
MaxAuthTries 16
MaxSessions 28

# Protocol
Protocol 2
