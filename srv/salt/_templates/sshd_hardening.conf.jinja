# Hardened SSH configuration for production
# Generated from srv/salt/_templates/sshd_hardening.conf.jinja
# Deployed by Salt - cozy-salt project
# NOTE: Port is managed in /etc/ssh/sshd_config via file.replace (linux/config.sls)
# Do NOT set Port here to avoid dual-port binding issues

# Authentication
PasswordAuthentication no
PubkeyAuthentication yes
PermitRootLogin prohibit-password
PermitEmptyPasswords no

# Security
{% if grains['os_family'] == 'Windows' %}
# Windows OpenSSH specific
KbdInteractiveAuthentication no
PubkeyAcceptedKeyTypes ssh-ed25519,ssh-rsa,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521
{% else %}
# Unix/Linux specific
ChallengeResponseAuthentication no
UsePAM yes
{% endif %}

# Session limits
MaxAuthTries 10
MaxSessions 10

# Keep alive
ClientAliveInterval 600
ClientAliveCountMax 0

# Protocol
Protocol 2

# Banner
PrintMotd yes
{% if grains['os_family'] == 'Windows' %}
Banner "C:\ProgramData\ssh\motd.txt"
{% else %}
Banner /etc/motd
{% endif %}

AcceptEnv __*_GATE__
AcceptEnv __PROXYJUMP_GATE__
AcceptEnv *INTERACTIVE*
AcceptEnv COLORTERM
AcceptEnv LANG LC_*
AcceptEnv LC_ADDRESS
AcceptEnv LC_ADDRESS
AcceptEnv LC_ALL
AcceptEnv LC_ALL
AcceptEnv LC_COLLATE
AcceptEnv LC_COLLATE
AcceptEnv LC_CTYPE
AcceptEnv LC_CTYPE
AcceptEnv LC_IDENTIFICATION
AcceptEnv LC_IDENTIFICATION
AcceptEnv LC_MEASUREMENT
AcceptEnv LC_MEASUREMENT
AcceptEnv LC_MESSAGES
AcceptEnv LC_MESSAGES
AcceptEnv LC_MONETARY
AcceptEnv LC_MONETARY
AcceptEnv LC_NAME
AcceptEnv LC_NAME
AcceptEnv LC_NUMERIC
AcceptEnv LC_NUMERIC
AcceptEnv LC_PAPER
AcceptEnv LC_PAPER
AcceptEnv LC_TELEPHONE
AcceptEnv LC_TELEPHONE
AcceptEnv LC_TIME
AcceptEnv LC_TIME
AcceptEnv NO_COLOR
AcceptEnv TERM
AcceptEnv TERM_PROGRAM
