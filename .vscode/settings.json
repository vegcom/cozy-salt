{
  "[css]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": [
      "SashaBusinaro.yaml-compose-sorter",
      "trunk.io"
    ]
  },
  "[dockerfile]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": [
      "jeff-hykin.better-dockerfile-syntax",
      "trunk.io"
    ]
  },
  "[html]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[jinja-json]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "editor.formatOnSave": true,
    "multiFormatter.formatterList": ["akrikun.saltstack-toolkit", "trunk.io"]
  },
  "[jinja-yaml]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "editor.formatOnSave": true,
    "multiFormatter.formatterList": ["akrikun.saltstack-toolkit", "trunk.io"]
  },
  "[jinja]": {
    "editor.defaultFormatter": "akrikun.saltstack-toolkit",
    "editor.formatOnSave": true,
    "multiFormatter.formatterList": ["akrikun.saltstack-toolkit", "trunk.io"]
  },
  "[jsonl]": {
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.sortJSON": "explicit"
    },
    "editor.defaultFormatter": "trunk.io",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnType": true,
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.sortJSON": "explicit"
    },
    "editor.defaultFormatter": "trunk.io",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.formatOnType": true,
    "editor.tabSize": 2
  },
  "[less]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[markdown]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[plaintext]": {
    "editor.defaultFormatter": "trunk.io",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false
  },
  "[python]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[scss]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "trunk.io"
  },
  "[sql]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": ["adpyke.vscode-sql-formatter", "trunk.io"]
  },
  "[toml]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": ["tamasfe.even-better-toml", "trunk.io"]
  },
  "[xml]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": ["redhat.vscode-xml", "trunk.io"]
  },
  "[yaml]": {
    "editor.defaultFormatter": "Jota0222.multi-formatter",
    "multiFormatter.formatterList": ["trunk.io"]
  },
  "direnv.restart.automatic": true,
  "djlint.enableLinting": false,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "errorLens.respectUpstreamEnabled": {
    "statusBar": true
  },
  "files.associations": {
    ".bandit": "ini",
    ".env.example": "env",
    ".gitattributes*": "gitconfig",
    ".gitconfig*": "gitconfig",
    ".gitmessage*": "git-commit",
    ".markdownlintignore": "plaintext",
    ".prettierrc": "json",
    ".salt-lint": "yaml",
    ".shellcheckrc": "shellscript",
    ".vscode/settings.json": "json",
    "*.json": "json",
    "*.sls": "jinja",
    "*.sls.example": "jinja",
    "LICENSE": "raw",
    "torrc": "properties"
  },
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "json.schemaDownload.enable": true,
  "json.validate.enable": true,
  "problems.autoReveal": true,
  "problems.showCurrentInStatus": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.extraPaths": [
    "/opt/saltstack/salt/lib/python3.11/site-packages",
    "/opt/saltstack/salt/lib/python3.10/site-packages",
    "/opt/saltstack/salt/lib/python3.14/site-packages"
  ],
  "python.autoComplete.extraPaths": [
    "/opt/saltstack/salt/lib/python3.11/site-packages",
    "/opt/saltstack/salt/lib/python3.10/site-packages",
    "/opt/saltstack/salt/lib/python3.14/site-packages"
  ],
  "python.testing.pytestArgs": ["tests"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": true,
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.enable": true,
  "ruff.fixAll": false,
  "ruff.format.backend": "uv",
  "ruff.lint.enable": true,
  "ruff.organizeImports": true,
  "ruff.showSyntaxErrors": true,
  "ruff.trace.server": "messages",
  "rust-analyzer.diagnostics.enable": true,
  "saltstack.format.enforceDashTags": true,
  "saltstack.lint.duplicateStateIds": true,
  "saltstack.lint.enabled": true,
  "saltstack.lint.jinjaBlocks": false,
  "saltstack.lint.tabs": true,
  "saltstack.lint.trailingWhitespace": true,
  "saltstack.pillarRoots": ["srv/pillar"],
  "saltstack.stateRoots": [
    "${workspaceFolder}/srv/salt",
    "${workspaceFolder}/provisioning"
  ],
  "xml.fileAssociations": [
    {
      "pattern": "${workspaceFolder}/provisioning/windows/tasks/*/*.xml",
      "systemId": "${workspaceFolder}/.vscode/tasks.xsd"
    }
  ],
  "xml.format.xsiSchemaLocationSplit": "onElement",
  "yaml-compose-sorter.addBlankLinesBetweenServices": false,
  "yaml-compose-sorter.addBlankLinesBetweenTopLevelKeys": false,
  "yaml-compose-sorter.transformKeyValueLists": true
}
